generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Lid {
  id                      Int                              @id @default(autoincrement())
  naamPersoon             String                           @map("naam_persoon")
  telefoonnummer          String?
  mailadres               String?
  ovamId                  String                           @unique @map("ovam_id")
  certificaatnummer       String                           @unique
  uitgereiktOp            DateTime?                        @map("uitgereikt_op") @db.Date
  bedrijf                 String?
  aansluiting             String?
  opmerking               String?                          @db.Text
  certificatiePlatform    String?                          @map("certificatie_platform")
  aangemaaktOp            DateTime                         @default(now()) @map("aangemaakt_op")
  bijgewerktOp            DateTime                         @updatedAt @map("bijgewerkt_op")
  verwijderdOp            DateTime?                        @map("verwijderd_op")
  deskcontroles           Deskcontrole[]
  terreincontroleDossiers TerreincontroleDossier[]
  laattijdigeMeldingen    LaattijdigePlaatsbezoekMelding[]

  @@index([verwijderdOp])
  @@index([verwijderdOp, naamPersoon, id])
  @@map("leden")
}

enum Ondernemingstype {
  EENMANSZAAK
  BEDRIJF
}

model Procescertificaat {
  id                      Int                      @id @default(autoincrement())
  naamBedrijf             String                   @map("naam_bedrijf")
  kboNummer               String                   @unique @map("kbo_nummer")
  certificaatnummer       String                   @unique
  uitgereiktOp            DateTime?                @map("uitgereikt_op") @db.Date
  oneDrive                String?                  @map("onedrive_url")
  opmerking               String?                  @db.Text
  ondernemingstype        Ondernemingstype         @map("ondernemingstype")
  aangemaaktOp            DateTime                 @default(now()) @map("aangemaakt_op")
  bijgewerktOp            DateTime                 @updatedAt @map("bijgewerkt_op")
  verwijderdOp            DateTime?                @map("verwijderd_op")
  deskcontroles           Deskcontrole[]
  terreincontroleDossiers TerreincontroleDossier[]

  @@index([verwijderdOp])
  @@index([verwijderdOp, naamBedrijf, id])
  @@map("procescertificaten")
}

enum DeskcontroleStatus {
  GEEN
  IN_OPMAAK
  GEACTUALISEERD
  AFGEROND
}

enum DeskcontroleType {
  NIEUWE_CONTROLE
  OPVOLGING
}

enum TerreincontroleStatus {
  GEARCHIVEERD_ATTEST
  ACTUEEL_ATTEST
  IN_OPMAAK
}

model Terreincontrole {
  id                   Int                    @id @default(autoincrement())
  auditeur             String?
  factuurVerzonden     Boolean?               @default(false) @map("factuur_verzonden")
  status               TerreincontroleStatus?
  attestUrl            String?                @map("attest_url")
  opmerkingen          String?
  adres                String?
  datumPlaatsbezoek    DateTime?              @map("datum_plaatsbezoek") @db.Date
  uurPlaatsbezoek      DateTime?              @map("uur_plaatsbezoek") @db.Time(6)
  ovamId               String?                @map("ovam_id")
  naamAdi              String?                @map("naam_adi")
  bedrijfsnaam         String?
  attestId             String                 @unique @map("attest_id") @db.Uuid
  bronBestandsnaam     String?                @map("bron_bestandsnaam")
  bronExcelRij         Int?                   @map("bron_excel_rij")
  aangemaaktOp         DateTime               @default(now()) @map("aangemaakt_op")
  bijgewerktOp         DateTime               @updatedAt @map("bijgewerkt_op")
  verwijderdOp         DateTime?              @map("verwijderd_op")
  afwezigOp            DateTime?              @map("afwezig_op")
  afwezigReden         String?                @map("afwezig_reden")
  bouwjaar             Int?
  extraAdresDetails    String?                @map("extra_adres_details")
  gemeente             String?
  huisnummer           String?
  inspectielocatie     String?
  perceelAfdelingscode String?                @map("perceel_afdelingscode")
  perceelGemeenteCode  String?                @map("perceel_gemeente_code")
  perceelSectieCode    String?                @map("perceel_sectie_code")
  postcode             String?
  straat               String?
  vloeroppervlakteM2   String?                @map("vloeroppervlakte_m2")
  auditeurGebruikerId  Int?                   @map("auditeur_gebruiker_id")
  auditeurGebruiker    ToegestaneGebruiker?   @relation("TerreincontroleAuditeur", fields: [auditeurGebruikerId], references: [id])

  @@index([ovamId])
  @@index([status])
  @@index([auditeurGebruikerId])
  @@index([datumPlaatsbezoek])
  @@index([verwijderdOp])
  @@index([verwijderdOp, datumPlaatsbezoek(sort: Desc), id(sort: Desc)])
  @@index([verwijderdOp, afwezigOp, datumPlaatsbezoek(sort: Desc), id(sort: Desc)], map: "terreincontroles_afwezig_lijst_idx")
  @@index([verwijderdOp, afwezigOp, ovamId], map: "terreincontroles_afwezig_ovam_idx")
  @@index([postcode])
  @@index([gemeente])
  @@map("terreincontroles")
}

model TerreincontroleDossier {
  id Int @id @default(autoincrement())

  auditeur            String               @db.VarChar(255)
  auditeurGebruikerId Int?                 @map("auditeur_gebruiker_id")
  auditeurGebruiker   ToegestaneGebruiker? @relation("TerreincontroledossierAuditeur", fields: [auditeurGebruikerId], references: [id], onDelete: SetNull)

  naamAdi      String @map("naam_adi") @db.VarChar(255)
  linkAttest   String @unique @map("link_attest") @db.VarChar(2000)
  attestId     String @unique @map("attest_id") @db.Uuid
  attestnummer String @unique @db.VarChar(255)

  status               DeskcontroleStatus @default(GEEN)
  certificatiePlatform String?            @map("certificatie_platform") @db.VarChar(255)
  opmerkingen          String?            @db.Text
  datumControle        DateTime           @map("datum_controle") @db.Date
  adres                String?            @db.VarChar(1000)

  persoonsId String @map("persoons_id") @db.VarChar(100)

  lidId Int @map("lid_id")
  lid   Lid @relation(fields: [lidId], references: [id], onDelete: Restrict)

  bedrijfsnaam       String @db.VarChar(500)
  ondernemingsnummer String @db.VarChar(100)

  procescertificaatId Int?               @map("procescertificaat_id")
  procescertificaat   Procescertificaat? @relation(fields: [procescertificaatId], references: [id], onDelete: Restrict)

  persoonscertificaatNummer String @map("persoonscertificaat_nummer") @db.VarChar(255)
  procescertificaatNummer   String @map("procescertificaat_nummer") @db.VarChar(255)

  bronBestandsnaam String? @map("bron_bestandsnaam") @db.VarChar(255)
  bronExcelRij     Int?    @map("bron_excel_rij")

  aangemaaktOp DateTime  @default(now()) @map("aangemaakt_op")
  bijgewerktOp DateTime  @updatedAt @map("bijgewerkt_op")
  verwijderdOp DateTime? @map("verwijderd_op")

  vaststellingen TerreincontroleVaststelling[]

  @@index([auditeurGebruikerId])
  @@index([lidId])
  @@index([lidId, verwijderdOp])
  @@index([procescertificaatId])
  @@index([persoonsId])
  @@index([ondernemingsnummer])
  @@index([status])
  @@index([datumControle])
  @@index([verwijderdOp])
  @@index([verwijderdOp, datumControle(sort: Desc), id(sort: Desc)])
  @@map("terreincontrole_dossiers")
}

model TerreincontroleVaststelling {
  id                       Int                    @id @default(autoincrement())
  terreincontroleDossierId Int                    @map("terreincontrole_dossier_id")
  terreincontroleDossier   TerreincontroleDossier @relation(fields: [terreincontroleDossierId], references: [id], onDelete: Cascade)

  excelRij            Int      @map("excel_rij")
  parameter           String?
  ncId                String   @map("nc_id")
  omschrijving        String?  @db.Text
  vastgesteldDoorCi   String?  @map("vastgesteld_door_ci")
  verduidelijking     String?  @db.Text
  groteImpact         String?  @map("grote_impact")
  categorie           String?
  motivatieAanpassing String?  @map("motivatie_aanpassing") @db.Text
  aangemaaktOp        DateTime @default(now()) @map("aangemaakt_op")

  @@index([terreincontroleDossierId])
  @@index([ncId])
  @@index([categorie])
  @@map("terreincontrole_vaststellingen")
}

model Deskcontrole {
  id Int @id @default(autoincrement())

  attestId            String?              @unique @map("attest_id") @db.Uuid
  auditeur            String?
  auditeurGebruikerId Int?                 @map("auditeur_gebruiker_id")
  auditeurGebruiker   ToegestaneGebruiker? @relation("DeskcontroleAuditeur", fields: [auditeurGebruikerId], references: [id], onDelete: SetNull)
  linkAttest          String?              @unique @map("link_attest")
  attestnummer        String?              @unique

  lidId Int @map("lid_id")
  lid   Lid @relation(fields: [lidId], references: [id], onDelete: Restrict)

  procescertificaatId Int?               @map("procescertificaat_id")
  procescertificaat   Procescertificaat? @relation(fields: [procescertificaatId], references: [id], onDelete: Restrict)

  status       DeskcontroleStatus @default(GEEN)
  typeControle DeskcontroleType?  @map("type_controle")

  deadlineSanctie   DateTime? @map("deadline_sanctie") @db.Date
  deadlineCorrectie DateTime? @map("deadline_correctie") @db.Date

  mailSanctieVerzonden   Boolean? @default(false) @map("mail_sanctie_verzonden")
  mailCorrectieVerzonden Boolean? @default(false) @map("mail_correctie_verzonden")

  oneDrive                 String?  @map("onedrive_url")
  voorwaardelijkeOpheffing Boolean? @default(false) @map("voorwaardelijke_opheffing")
  opmerkingen              String?  @db.Text

  datumControle    DateTime  @map("datum_controle") @db.Date
  adres            String?
  finalisatieDatum DateTime? @map("finalisatie_datum") @db.Date

  aangemaaktOp DateTime  @default(now()) @map("aangemaakt_op")
  bijgewerktOp DateTime  @updatedAt @map("bijgewerkt_op")
  verwijderdOp DateTime? @map("verwijderd_op")

  vaststellingen DeskcontroleVaststelling[]

  @@index([lidId])
  @@index([lidId, verwijderdOp])
  @@index([procescertificaatId])
  @@index([auditeurGebruikerId])
  @@index([status])
  @@index([typeControle])
  @@index([datumControle])
  @@index([deadlineSanctie])
  @@index([deadlineCorrectie])
  @@index([finalisatieDatum])
  @@index([verwijderdOp])
  @@index([verwijderdOp, datumControle, id])
  @@map("deskcontroles")
}

model DeskcontroleVaststelling {
  id             Int          @id @default(autoincrement())
  deskcontroleId Int          @map("deskcontrole_id")
  deskcontrole   Deskcontrole @relation(fields: [deskcontroleId], references: [id], onDelete: Cascade)

  excelRij            Int      @map("excel_rij")
  parameter           String?
  ncId                String   @map("nc_id")
  omschrijving        String?  @db.Text
  vastgesteldDoorCi   String?  @map("vastgesteld_door_ci")
  verduidelijking     String?  @db.Text
  groteImpact         String?  @map("grote_impact")
  categorie           String?
  motivatieAanpassing String?  @map("motivatie_aanpassing") @db.Text
  aangemaaktOp        DateTime @default(now()) @map("aangemaakt_op")

  @@index([deskcontroleId])
  @@index([ncId])
  @@index([categorie])
  @@map("deskcontrole_vaststellingen")
}

enum Gebruikersrol {
  BEHEERDER
  ADMINISTRATIEF
  AUDITEUR
}

model ToegestaneGebruiker {
  id                 Int           @id @default(autoincrement())
  email              String        @unique
  naam               String?
  voornaam           String?
  achternaam         String?
  profielVoltooidOp  DateTime?     @map("profiel_voltooid_op")
  rol                Gebruikersrol @default(AUDITEUR)
  beheerder          Boolean       @default(false)
  actief             Boolean       @default(true)
  authUserId         String?       @unique @map("auth_user_id")
  uitgenodigdOp      DateTime?     @map("uitgenodigd_op")
  aangemaaktOp       DateTime      @default(now()) @map("aangemaakt_op")
  bijgewerktOp       DateTime      @updatedAt @map("bijgewerkt_op")
  wachtwoordWijzigen Boolean       @default(true)

  deskcontroles                Deskcontrole[]               @relation("DeskcontroleAuditeur")
  terreincontroles             Terreincontrole[]            @relation("TerreincontroleAuditeur")
  terreincontroleDossiers      TerreincontroleDossier[]     @relation("TerreincontroledossierAuditeur")
  meldingen                    Melding[]
  auditlogs                    Auditlog[]
  terreincontroleReserveringen TerreincontroleReservering[]
  pushAbonnementen             PushAbonnement[]
  opvolgingenAlsAuditeur       OpvolgingSanctie[]           @relation("OpvolgingSanctieAuditeur")
  opvolgingenAfgerondDoor      OpvolgingSanctie[]           @relation("OpvolgingSanctieAfgerondDoor")
  opvolgingenAangemaakt        OpvolgingSanctie[]           @relation("OpvolgingSanctieAangemaaktDoor")

  opvolgingSanctieMailsAangemaakt OpvolgingSanctieMail[] @relation("OpvolgingSanctieMailAangemaaktDoor")

  @@index([email])
  @@index([actief])
  @@index([beheerder])
  @@index([rol])
  @@map("toegestane_gebruikers")
}

model Melding {
  id          Int                 @id @default(autoincrement())
  gebruikerId Int                 @map("gebruiker_id")
  gebruiker   ToegestaneGebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  sleutel String  @db.VarChar(255)
  type    String  @db.VarChar(50)
  titel   String  @db.VarChar(255)
  bericht String  @db.Text
  href    String? @db.VarChar(2000)

  gelezenOp    DateTime? @map("gelezen_op")
  aangemaaktOp DateTime  @default(now()) @map("aangemaakt_op")
  bijgewerktOp DateTime  @updatedAt @map("bijgewerkt_op")

  @@unique([gebruikerId, sleutel])
  @@index([gebruikerId, gelezenOp])
  @@index([gebruikerId, aangemaaktOp])
  @@index([type])
  @@map("meldingen")
}

model Auditlog {
  id Int @id @default(autoincrement())

  gebruikerId Int?                 @map("gebruiker_id")
  gebruiker   ToegestaneGebruiker? @relation(fields: [gebruikerId], references: [id], onDelete: SetNull)

  gebruikerNaam  String? @map("gebruiker_naam") @db.VarChar(255)
  gebruikerEmail String? @map("gebruiker_email") @db.VarChar(320)

  actie      String @db.VarChar(100)
  entiteit   String @db.VarChar(100)
  entiteitId Int?   @map("entiteit_id")

  omschrijving String? @db.Text
  oudeWaarde   Json?   @map("oude_waarde")
  nieuweWaarde Json?   @map("nieuwe_waarde")
  metadata     Json?

  aangemaaktOp DateTime @default(now()) @map("aangemaakt_op")

  @@index([gebruikerId, aangemaaktOp])
  @@index([entiteit, entiteitId, aangemaaktOp])
  @@index([actie])
  @@index([aangemaaktOp])
  @@map("auditlogs")
}

model AttestPersoonStatistiek {
  id             Int    @id @default(autoincrement())
  persoonsId     String @unique @map("persoons_id") @db.VarChar(100)
  naam           String @db.VarChar(255)
  aantalAttesten Int    @map("aantal_attesten")

  bronBestandsnaam String? @map("bron_bestandsnaam") @db.VarChar(255)

  aangemaaktOp DateTime @default(now()) @map("aangemaakt_op")
  bijgewerktOp DateTime @updatedAt @map("bijgewerkt_op")

  @@index([naam])
  @@index([aantalAttesten])
  @@map("attest_persoon_statistieken")
}

model AttestBedrijfStatistiek {
  id                  Int    @id @default(autoincrement())
  bedrijfsnaam        String @db.VarChar(500)
  bedrijfsnaamSleutel String @unique @map("bedrijfsnaam_sleutel") @db.VarChar(500)
  aantalAttesten      Int    @map("aantal_attesten")

  bronBestandsnaam String? @map("bron_bestandsnaam") @db.VarChar(255)

  aangemaaktOp DateTime @default(now()) @map("aangemaakt_op")
  bijgewerktOp DateTime @updatedAt @map("bijgewerkt_op")

  @@index([bedrijfsnaam])
  @@index([aantalAttesten])
  @@map("attest_bedrijf_statistieken")
}

model AttestCorrectie {
  id             Int    @id @default(autoincrement())
  persoonsId     String @map("persoons_id") @db.VarChar(100)
  bedrijfsnaam   String @db.VarChar(500)
  naam           String @db.VarChar(255)
  aantalAttesten Int    @map("aantal_attesten")

  aangemaaktOp DateTime @default(now()) @map("aangemaakt_op")
  bijgewerktOp DateTime @updatedAt @map("bijgewerkt_op")

  @@index([persoonsId])
  @@index([bedrijfsnaam])
  @@index([naam])
  @@map("attest_correcties")
}

model AttestStatistiekImport {
  id Int @id

  bronBestandsnaam String   @map("bron_bestandsnaam") @db.VarChar(255)
  geimporteerdOp   DateTime @default(now()) @map("geimporteerd_op")

  aantalExcelRijen Int @map("aantal_excel_rijen")
  aantalPersonen   Int @map("aantal_personen")
  aantalBedrijven  Int @map("aantal_bedrijven")

  correctiesToegepastOp DateTime? @map("correcties_toegepast_op")

  @@map("attest_statistiek_imports")
}

model TerreincontroleReservering {
  id Int @id @default(autoincrement())

  attestId String @unique @map("attest_id") @db.Uuid

  gebruikerId Int                 @map("gebruiker_id")
  gebruiker   ToegestaneGebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  gereserveerdOp DateTime @default(now()) @map("gereserveerd_op")
  verlooptOp     DateTime @map("verloopt_op")
  bijgewerktOp   DateTime @updatedAt @map("bijgewerkt_op")

  @@index([gebruikerId])
  @@index([verlooptOp])
  @@map("terreincontrole_reserveringen")
}

enum NaFinalisatiePlaatsbezoek {
  SPONTAAN
  TELEFONISCHE_AFSPRAAK
  EMAILAFSPRAAK
  KLACHT
}

enum NaFinalisatieTypeControle {
  GEHEEL
  DEELS
  ENKEL_OPENBARE_WEG
}

model NaFinalisatie {
  id Int @id @default(autoincrement())

  auditeur      String  @db.VarChar(255)
  naamAdi       String? @map("naam_adi") @db.VarChar(255)
  geregistreerd Boolean @default(false)

  linkAttest   String @map("link_attest") @db.VarChar(2000)
  attestnummer String @db.VarChar(255)
  attestId     String @map("attest_id") @db.Uuid

  datumNaFinalisatie DateTime                  @map("datum_na_finalisatie") @db.Date
  plaatsbezoek       NaFinalisatiePlaatsbezoek
  typeControle       NaFinalisatieTypeControle @map("type_controle")
  reden              String?                   @db.Text
  opmerking          String                    @db.Text

  inspectielocatie String? @db.Text
  naamBedrijf      String? @map("naam_bedrijf") @db.VarChar(500)
  persoonsId       String? @map("persoons_id") @db.VarChar(100)

  bronId           String?   @unique @map("bron_id") @db.VarChar(255)
  bronBestandsnaam String?   @map("bron_bestandsnaam") @db.VarChar(255)
  aangemaaktOp     DateTime  @default(now()) @map("aangemaakt_op")
  bijgewerktOp     DateTime  @updatedAt @map("bijgewerkt_op")
  verwijderdOp     DateTime? @map("verwijderd_op")

  @@index([verwijderdOp])
  @@index([verwijderdOp, datumNaFinalisatie(sort: Desc), id(sort: Desc)])
  @@index([geregistreerd])
  @@index([datumNaFinalisatie])
  @@index([auditeur])
  @@index([persoonsId])
  @@index([attestId])
  @@index([attestId, datumNaFinalisatie, plaatsbezoek, typeControle])
  @@map("na_finalisatie")
}

model LaattijdigePlaatsbezoekMelding {
  id Int @id @default(autoincrement())

  lidId        Int    @map("lid_id")
  naamAdi      String @map("naam_adi") @db.VarChar(255)
  bedrijfsnaam String @db.VarChar(500)

  aangemeldOp DateTime @default(now()) @map("aangemeld_op")

  lid      Lid                      @relation(fields: [lidId], references: [id], onDelete: Restrict)
  bezoeken LaattijdigPlaatsbezoek[]

  @@index([lidId])
  @@index([aangemeldOp])
  @@index([aangemeldOp(sort: Desc), id(sort: Desc)])
  @@map("laattijdige_plaatsbezoek_meldingen")
}

model LaattijdigPlaatsbezoek {
  id Int @id @default(autoincrement())

  meldingId Int @map("melding_id")

  inspectielocatie        String   @db.VarChar(500)
  geopuntId               String?  @map("geopunt_id") @db.VarChar(100)
  straat                  String?  @db.VarChar(255)
  huisnummer              String?  @db.VarChar(50)
  busnummer               String?  @db.VarChar(50)
  postcode                String?  @db.VarChar(20)
  gemeente                String?  @db.VarChar(255)
  extraAdresdetails       String?  @map("extra_adresdetails") @db.Text
  gemeenschappelijkeDelen Boolean  @default(false) @map("gemeenschappelijke_delen")
  latitude                Decimal? @db.Decimal(10, 7)
  longitude               Decimal? @db.Decimal(10, 7)

  datumPlaatsbezoek DateTime @map("datum_plaatsbezoek") @db.Date
  tijdstip          DateTime @db.Time(0)
  reden             String   @db.Text

  aangemaaktOp DateTime @default(now()) @map("aangemaakt_op")

  melding          LaattijdigePlaatsbezoekMelding @relation(fields: [meldingId], references: [id], onDelete: Cascade)
  pushVerzendingen PushVerzending[]

  @@index([meldingId])
  @@index([datumPlaatsbezoek])
  @@index([aangemaaktOp])
  @@index([aangemaaktOp(sort: Desc), id(sort: Desc)])
  @@map("laattijdige_plaatsbezoeken")
}

model PushAbonnement {
  id Int @id @default(autoincrement())

  gebruikerId Int                 @map("gebruiker_id")
  gebruiker   ToegestaneGebruiker @relation(fields: [gebruikerId], references: [id], onDelete: Cascade)

  endpoint  String  @unique @db.VarChar(2048)
  p256dh    String  @db.VarChar(255)
  auth      String  @db.VarChar(255)
  userAgent String? @map("user_agent") @db.VarChar(500)

  aangemaaktOp DateTime @default(now()) @map("aangemaakt_op")
  bijgewerktOp DateTime @updatedAt @map("bijgewerkt_op")

  verzendingen PushVerzending[]

  @@index([gebruikerId])
  @@map("push_abonnementen")
}

model PushVerzending {
  id Int @id @default(autoincrement())

  plaatsbezoekId Int                    @map("plaatsbezoek_id")
  plaatsbezoek   LaattijdigPlaatsbezoek @relation(fields: [plaatsbezoekId], references: [id], onDelete: Cascade)

  abonnementId Int            @map("abonnement_id")
  abonnement   PushAbonnement @relation(fields: [abonnementId], references: [id], onDelete: Cascade)

  status       String    @default("WACHTEND") @db.VarChar(20)
  pogingen     Int       @default(0)
  verzondenOp  DateTime? @map("verzonden_op")
  laatsteFout  String?   @map("laatste_fout") @db.Text
  aangemaaktOp DateTime  @default(now()) @map("aangemaakt_op")
  bijgewerktOp DateTime  @updatedAt @map("bijgewerkt_op")

  @@unique([plaatsbezoekId, abonnementId])
  @@index([status])
  @@index([aangemaaktOp])
  @@map("push_verzendingen")
}

enum OpvolgingSanctieBron {
  DESKCONTROLE
  TERREINCONTROLE
  NA_FINALISATIE
}

enum OpvolgingNcCategorie {
  CAT_0
  CAT_1
  CAT_2
  CAT_3
  CAT_4
}

model OpvolgingSanctie {
  id Int @id @default(autoincrement())

  bronType OpvolgingSanctieBron @map("bron_type")
  bronId   Int                  @map("bron_id")

  auditeur            String?
  auditeurGebruikerId Int?                 @map("auditeur_gebruiker_id")
  auditeurGebruiker   ToegestaneGebruiker? @relation("OpvolgingSanctieAuditeur", fields: [auditeurGebruikerId], references: [id], onDelete: SetNull)

  naamAdi String? @map("naam_adi")

  opvolgingAfgerond Boolean   @default(false) @map("opvolging_afgerond")
  datumAfgerond     DateTime? @map("datum_afgerond") @db.Date

  afgerondDoorGebruikerId Int?                 @map("afgerond_door_gebruiker_id")
  afgerondDoorGebruiker   ToegestaneGebruiker? @relation("OpvolgingSanctieAfgerondDoor", fields: [afgerondDoorGebruikerId], references: [id], onDelete: Restrict)

  linkAttest   String? @map("link_attest") @db.VarChar(2048)
  attestnummer String? @db.VarChar(255)

  reden String @db.Text

  bedrijfsnaam String? @db.VarChar(500)
  ovamId       String? @map("ovam_id") @db.VarChar(255)

  datumVaststelling DateTime @map("datum_vaststelling") @db.Date
  opmerkingen       String?  @db.Text

  ncCategorie OpvolgingNcCategorie @map("nc_categorie")

  sanctieBegindatum DateTime? @map("sanctie_begindatum") @db.Date
  sanctieEinddatum  DateTime? @map("sanctie_einddatum") @db.Date

  aangemaaktDoorId Int? @map("aangemaakt_door_id")

  aangemaaktDoor ToegestaneGebruiker? @relation("OpvolgingSanctieAangemaaktDoor", fields: [aangemaaktDoorId], references: [id], onDelete: SetNull)
  aangemaaktOp   DateTime             @default(now()) @map("aangemaakt_op")
  bijgewerktOp   DateTime             @updatedAt @map("bijgewerkt_op")
  verwijderdOp   DateTime?            @map("verwijderd_op")

  mails OpvolgingSanctieMail[]

  @@unique([bronType, bronId])
  @@index([auditeurGebruikerId])
  @@index([afgerondDoorGebruikerId])
  @@index([aangemaaktDoorId])
  @@index([opvolgingAfgerond])
  @@index([ncCategorie])
  @@index([datumVaststelling])
  @@index([sanctieBegindatum])
  @@index([sanctieEinddatum])
  @@index([verwijderdOp])
  @@index([verwijderdOp, datumVaststelling(sort: Desc), id(sort: Desc)])
  @@map("opvolging_sancties")
}

model OpvolgingSanctieMail {
  id                 Int              @id @default(autoincrement())
  opvolgingSanctieId Int              @map("opvolging_sanctie_id")
  opvolgingSanctie   OpvolgingSanctie @relation(fields: [opvolgingSanctieId], references: [id], onDelete: Cascade)

  bestandsnaam    String @db.VarChar(255)
  bestandstype    String @db.VarChar(10)
  mimeType        String @map("mime_type") @db.VarChar(255)
  bestandsgrootte Int    @map("bestandsgrootte")
  sha256          String @db.VarChar(64)

  afzenderNaam    String?  @map("afzender_naam") @db.VarChar(500)
  afzenderEmail   String   @map("afzender_email") @db.VarChar(320)
  ontvangers      Json
  cc              Json
  onderwerp       String?  @db.VarChar(1000)
  berichtId       String?  @map("bericht_id") @db.VarChar(1000)
  verzondenOp     DateTime @map("verzonden_op")
  tekstInhoud     String   @map("tekst_inhoud") @db.Text
  bijlagen        Json
  internVerzonden Boolean  @map("intern_verzonden")

  aangemaaktDoorId Int?                 @map("aangemaakt_door_id")
  aangemaaktDoor   ToegestaneGebruiker? @relation("OpvolgingSanctieMailAangemaaktDoor", fields: [aangemaaktDoorId], references: [id], onDelete: SetNull)

  aangemaaktOp DateTime @default(now()) @map("aangemaakt_op")

  @@unique([opvolgingSanctieId, sha256])
  @@index([opvolgingSanctieId, verzondenOp, id])
  @@index([aangemaaktDoorId])
  @@map("opvolging_sanctie_mails")
}
